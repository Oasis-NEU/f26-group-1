# Copy to .env.local and fill in. Only these two values ever go to the browser.
# Local Supabase: run `npm run db:start` and copy the API URL and anon key it prints.
# Hosted Supabase: Project Settings → API.
# Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
