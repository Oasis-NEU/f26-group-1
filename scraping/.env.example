# Reddit API credentials. Copy to .env (gitignored) and fill in.
# Create the app at https://www.reddit.com/prefs/apps once Reddit approves API access.
REDDIT_CLIENT_ID=
# Leave empty if the app type is "installed app".
REDDIT_CLIENT_SECRET=
# The team Reddit account that owns the app (without /u/).
REDDIT_USERNAME=

# Optional, for boston_open_data.py: a free MBTA key (https://api-v3.mbta.com) raises the
# rate limit from 20 to 1000 requests/minute. Works without one, just slower on big lists.
MBTA_API_KEY=
